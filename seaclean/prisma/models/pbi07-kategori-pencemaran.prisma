enum JenisPencemaran {
  SAMPAH
  LIMBAH
  MINYAK
  ALAT_TANGKAP_MERUSAK
}

// ringan, sedang, parah
enum TingkatKeparahan {
  RINGAN
  SEDANG
  PARAH
}

model KategoriPencemaran {
  id               Int              @id @default(autoincrement()) @map("id_kategori")
  nama             String           @unique @map("nama_kategori")
  jenis            JenisPencemaran
  tingkatKeparahan TingkatKeparahan @map("tingkat_keparahan")
  // hex, contoh #22c55e
  warnaPeta        String           @map("warna_marker")
  deskripsi        String?
  ikonUrl          String?          @map("ikon_url")
  aktif            Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // relasi
  // laporan LaporanPencemaran[] // PBI-09

  @@index([aktif, jenis])
  @@map("kategori_pencemaran")
}
